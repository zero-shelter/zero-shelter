{
  "name": "zero-shelter",
  "version": "0.0.7",
  "description": "Local-first, deterministic security tooling for AI-assisted development.",
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Present_Jay.Dev",
      "url": "https://github.com/PresentJay"
    },
    {
      "name": "Groot",
      "url": "https://github.com/msnodeve"
    },
    {
      "name": "Hyeona",
      "url": "https://github.com/hadevyi"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "third-party": "node scripts/third-party.mjs",
    "qa": "node scripts/qa-install.mjs",
    "qa:agent": "node scripts/qa-agent.mjs",
    "bench:sheets": "node bench/make-decision-sheets.mjs",
    "bench:score": "node bench/score-labels.mjs",
    "judge": "node dist/bin.js judge",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zero-shelter/zero-shelter.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "zero-shelter": "./dist/bin.js"
  }
}
