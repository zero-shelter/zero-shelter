{
  "name": "zero-shelter",
  "version": "0.0.0",
  "description": "Local-first, deterministic security tooling for AI-assisted development.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
